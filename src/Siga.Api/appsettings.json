{
  "ConnectionStrings": {
    "Administracion": ""
  },
  "Jwt": {
    "Issuer": "siga-api",
    "Audience": "siga-mobile",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "RefreshTokenDays": 14,
    "AutoEnrollOnFirstLogin": true,
    "ActiveStatuses": [ "ACTIVO" ]
  },
  "OpenApi": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*"
}
